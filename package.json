{
  "name": "sarovar-jinalaya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Amplify Gen2 backend for the Sarovar Jinalaya temple community app",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write amplify jest.config.ts eslint.config.js",
    "format:check": "prettier --check amplify jest.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:auth": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/auth amplify/backend.test.ts",
    "test:donation": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/data amplify/functions/donation",
    "test:feed": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/data/post amplify/functions/feed-api",
    "test:pdf": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/data/document amplify/functions/document",
    "test:suggestion": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/data/suggestion amplify/functions/suggestion-shared amplify/functions/submit-suggestion amplify/functions/all-suggestions",
    "sandbox": "ampx sandbox",
    "test:reminder": "NODE_OPTIONS=--experimental-vm-modules jest --rootDir . amplify/data/reminder amplify/functions/reminder amplify/functions/deliver-push amplify/functions/auto-clear"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.0",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-appsync/utils": "^2.1.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.3",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudwatch": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-scheduler": "^3.1136.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@smithy/signature-v4": "^5.7.3",
    "google-auth-library": "^11.1.0"
  }
}
